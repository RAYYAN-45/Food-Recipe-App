<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fcf2e4">

    <!-- JUDUL -->
    <TextView
        android:id="@+id/txtJudulKomunitas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Komunitas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#8B4513"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:id="@+id/layoutSearchKomunitas"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/txtJudulKomunitas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editSearchKomunitas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Cari nama user atau resep..."
            android:textColorHint="#9E9E9E"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:minHeight="48dp"
            android:imeOptions="actionSearch"
            android:inputType="text"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search"
            android:scaleType="fitCenter"/>

    </LinearLayout>

    <!-- TAB: SEMUA | TERSIMPAN -->
    <LinearLayout
        android:id="@+id/layoutTab"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutSearchKomunitas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TAB SEMUA -->
        <TextView
            android:id="@+id/tabSemua"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Semua"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8B4513"
            android:gravity="center"
            android:background="@drawable/bg_tab_active"
            android:clickable="true"
            android:focusable="true"/>

        <!-- TAB TERSIMPAN -->
        <TextView
            android:id="@+id/tabTersimpan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Tersimpan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:background="@drawable/bg_tab_inactive"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- RECYCLERVIEW POSTINGAN -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerKomunitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutTab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/txtEmptyKomunitas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tidak ada postingan ditemukan"
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FAB TAMBAH POSTINGAN (untuk Apip) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTambahPostingan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Tambah Postingan"
        app:backgroundTint="#8B4513"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>