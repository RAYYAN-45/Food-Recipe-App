<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fcf2e4">

    <TextView
        android:id="@+id/txtFavoriteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESEP TERSIMPAN"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#8B4513"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtFavoriteTitle"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/titleLokal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resep Bawaan Aplikasi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#8B4513"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavoritLokal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/titleKomunitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resep dari Komunitas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#8B4513"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavoritKomunitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/txtEmptyFavorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum ada resep favorit.\nKlik ikon ⭐ untuk menyimpan resep!"
        android:textSize="16sp"
        android:textColor="#666666"
        android:textAlignment="center"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>