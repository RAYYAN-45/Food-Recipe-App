<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fcf2e4">

    <!-- TOMBOL BACK -->
    <ImageButton
        android:id="@+id/btnBackDetail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:src="@drawable/arrow"
        android:scaleType="center"
        android:padding="10dp"
        android:background="@drawable/bg_button"
        android:elevation="6dp"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- NAMA USER -->
    <TextView
        android:id="@+id/txtNamaUserDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="nama_user"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3A3A3A"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBackDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- JUDUL RESEP -->
    <TextView
        android:id="@+id/txtJudulDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Judul Resep"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5a3e3e"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txtNamaUserDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DESKRIPSI -->
    <TextView
        android:id="@+id/txtDeskripsiDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deskripsi..."
        android:textSize="14sp"
        android:textColor="#7A7A7A"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txtJudulDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SECTION KOMENTAR - Anam isi di sini -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ Section Komentar - Anam ]"
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txtDeskripsiDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>